def split_csv(value):
    return [v.strip() for v in value.split(",") if v.strip()]


def run(cmd, env=None, cwd=None, check=True, capture=True):
    kwargs = {
        "env": env,
        "cwd": cwd,
        "text": True,
    }
    if capture:
        kwargs.update({"stdout": subprocess.PIPE, "stderr": subprocess.PIPE})
    proc = subprocess.run(cmd, **kwargs)
    if check and proc.returncode != 0:
        out = proc.stdout or ""
        err = proc.stderr or ""
        raise BenchError(
            "command failed: {}\n{}\n{}".format(
                " ".join(map(str, cmd)), out.strip(), err.strip()).strip()
        )
    return proc


def find_bin(name, bindir=None, extra=()):
    for candidate in extra:
        path = Path(candidate)
        if path.exists():
            return str(path)
    if bindir:
        path = Path(bindir) / name
        if path.exists():
            return str(path)
    path = shutil.which(name)
    if path:
        return path
    raise BenchError(f"could not find required program: {name}")


def get_bindir(pg_config):
    proc = run([pg_config, "--bindir"])
    return proc.stdout.strip()


def get_sharedir(pg_config):
    proc = run([pg_config, "--sharedir"], check=False)
    if proc.returncode == 0:
        return proc.stdout.strip()
    return None


def extension_root(script):
    path = Path(script).resolve()
    if path.parent.name == "bench":
        return path.parent.parent
    return path.parent


def postgres_source_root(script, configured_root):
    if configured_root:
        root = Path(configured_root).resolve()
        if not (root / "src" / "backend" / "postgres").exists():
            raise BenchError(f"not a PostgreSQL source tree: {root}")
        return root

    path = Path(script).resolve()
    if path.parent.name == "bench":
        path = path.parent.parent
    else:
        path = path.parent
    if path.name == "auto_explain_z" and path.parent.name == "contrib":
        return path.parent.parent
    return None


def build_contrib(pg_root, aez_root, pg_config):
    if pg_root is None:
        raise BenchError("--build-contrib requires --postgres-source for standalone runs")
    run(["make", "-C", str(pg_root / "contrib" / "auto_explain")], capture=False)
    env = os.environ.copy()
    env["PG_CONFIG"] = pg_config
    run(["make"], env=env, cwd=aez_root, capture=False)


def source_tree_bindir(paths, work, root):
    bindir = work / "bin"
    libdir = work / "lib"
    bindir.mkdir(parents=True, exist_ok=True)
    libdir.mkdir(parents=True, exist_ok=True)
    linked = {}
    for name in ("postgres", "initdb", "psql", "pgbench"):
        src = Path(paths[name])
        dst = bindir / name
        if dst.exists() or dst.is_symlink():
            dst.unlink()
        shutil.copy2(src, dst)
        linked[name] = str(dst)
    for ext in (".so", ".dylib"):
        for src in (
            root / "src" / "backend" / "snowball" / f"dict_snowball{ext}",
            root / "src" / "pl" / "plpgsql" / "src" / f"plpgsql{ext}",
        ):
            if src.exists():
                shutil.copy2(src, libdir / src.name)
    return linked


def source_tree_sharedir(root, work, installed_sharedir=None):
    sharedir = work / "share"
    sharedir.mkdir(parents=True, exist_ok=True)
    files = {
        root / "src" / "include" / "catalog" / "postgres.bki": "postgres.bki",
        root / "src" / "backend" / "libpq" / "pg_hba.conf.sample": "pg_hba.conf.sample",
        root / "src" / "backend" / "libpq" / "pg_ident.conf.sample": "pg_ident.conf.sample",
        root / "src" / "backend" / "utils" / "misc" / "postgresql.conf.sample": "postgresql.conf.sample",
        root / "src" / "backend" / "snowball" / "snowball_create.sql": "snowball_create.sql",
        root / "src" / "backend" / "catalog" / "information_schema.sql": "information_schema.sql",
        root / "src" / "backend" / "catalog" / "sql_features.txt": "sql_features.txt",
        root / "src" / "include" / "catalog" / "system_constraints.sql": "system_constraints.sql",
        root / "src" / "backend" / "catalog" / "system_functions.sql": "system_functions.sql",
        root / "src" / "backend" / "catalog" / "system_views.sql": "system_views.sql",
    }
    for src, dstname in files.items():
        if not src.exists():
            raise BenchError(f"missing source-tree initdb input: {src}")
        shutil.copy2(src, sharedir / dstname)

    extdir = sharedir / "extension"
    extdir.mkdir(parents=True, exist_ok=True)
    for name in ("plpgsql.control", "plpgsql--1.0.sql"):
        src = root / "src" / "pl" / "plpgsql" / "src" / name
        if src.exists():
            shutil.copy2(src, extdir / name)

    tznames = root / "src" / "timezone" / "tznames"
    if tznames.exists():
        shutil.copytree(tznames, sharedir / "timezonesets")

    installed_tzdir = Path(installed_sharedir) / "timezone" if installed_sharedir else None
    if installed_tzdir and installed_tzdir.exists():
        shutil.copytree(installed_tzdir, sharedir / "timezone")

    return str(sharedir)


def write_custom_workload_scripts(work):
    scripts = {}
    scriptdir = work / "workload_scripts"
    scriptdir.mkdir(parents=True, exist_ok=True)
    for name, body in CUSTOM_WORKLOADS.items():
        if isinstance(body, list):
            paths = []
            for suffix, script_body in body:
                path = scriptdir / f"{name}-{suffix}.sql"
                path.write_text(script_body.lstrip(), encoding="utf-8")
                paths.append(path)
            scripts[name] = paths
        else:
            path = scriptdir / f"{name}.sql"
            path.write_text(body.lstrip(), encoding="utf-8")
            scripts[name] = path
    return scripts


def pick_port():
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
        sock.bind(("127.0.0.1", 0))
        return sock.getsockname()[1]


def dir_size(path):
    path = Path(path)
    if not path.exists():
        return 0
    total = 0
    for child in path.rglob("*"):
        if child.is_file():
            total += child.stat().st_size
    return total


def file_size(path):
    path = Path(path)
    return path.stat().st_size if path.exists() else 0


def parse_ps_time(value):
    value = value.strip()
    days = 0
    if "-" in value:
        daystr, value = value.split("-", 1)
        days = int(daystr)
    parts = value.split(":")
    if len(parts) == 3:
        hours, minutes, seconds = parts
    elif len(parts) == 2:
        hours = 0
        minutes, seconds = parts
    else:
        return float(value)
    return days * 86400 + int(hours) * 3600 + int(minutes) * 60 + float(seconds)


def process_cpu_snapshot(root_pid):
    proc = run(["ps", "-axo", "pid=,ppid=,time="])
    children = {}
    times = {}
    for line in proc.stdout.splitlines():
        fields = line.strip().split(None, 2)
        if len(fields) != 3:
            continue
        pid = int(fields[0])
        ppid = int(fields[1])
        children.setdefault(ppid, []).append(pid)
        times[pid] = parse_ps_time(fields[2])

    total = 0.0
    stack = [root_pid]
    seen = set()
    while stack:
        pid = stack.pop()
        if pid in seen:
            continue
        seen.add(pid)
        total += times.get(pid, 0.0)
        stack.extend(children.get(pid, []))
    return total


def child_cpu_snapshot():
    usage = resource.getrusage(resource.RUSAGE_CHILDREN)
    return usage.ru_utime + usage.ru_stime


def parse_pgbench(output):
    result = {"raw": output}
    m = re.search(r"number of transactions actually processed:\s+([0-9]+)", output)
    if m:
        result["transactions"] = int(m.group(1))
    m = re.search(r"latency average =\s+([0-9.]+)\s+ms", output)
    if m:
        result["latency_ms"] = float(m.group(1))
    matches = re.findall(r"tps =\s+([0-9.]+)\s+\(([^)]*)\)", output)
    if matches:
        for value, label in matches:
            if "without initial connection time" in label:
                result["tps"] = float(value)
                break
        else:
            result["tps"] = float(matches[-1][0])
    return result


class Cluster:
    def __init__(self, args, paths, pg_root, aez_root):
        self.args = args
        self.paths = paths
        self.pg_root = pg_root
        self.aez_root = aez_root
        self.pgdata = paths["work"] / "data"
        self.sockdir = paths["sock"]
        self.port = args.port or pick_port()
        self.proc = None
        self.stderr_file = None

    def env(self, appname=None):
        env = os.environ.copy()
        env.update({
            "PGHOST": str(self.sockdir),
            "PGPORT": str(self.port),
            "PGDATABASE": self.args.database,
        })
        if self.args.user:
            env["PGUSER"] = self.args.user
        if appname:
            env["PGAPPNAME"] = appname
        return env

    def dynamic_library_path(self):
        dirs = []
        if self.pg_root is not None:
            dirs.append(str(self.pg_root / "contrib" / "auto_explain"))
        if self.aez_root is not None:
            dirs.append(str(self.aez_root))
        if self.args.dynamic_library_path:
            dirs.append(self.args.dynamic_library_path)
        if dirs:
            dirs.append("$libdir")
        return os.pathsep.join(dirs)

    def initdb(self):
        self.pgdata.parent.mkdir(parents=True, exist_ok=True)
        self.sockdir.mkdir(parents=True, exist_ok=True)
        cmd = [
            self.paths["initdb"],
            "-D", str(self.pgdata),
            "-A", "trust",
            "-N",
        ]
        if self.args.share_dir:
            cmd.extend(["-L", self.args.share_dir])
        elif self.paths.get("share"):
            cmd.extend(["-L", self.paths["share"]])
        run(cmd, capture=not self.args.verbose)

    def common_gucs(self):
        gucs = {
            "listen_addresses": "",
            "unix_socket_directories": str(self.sockdir),
            "log_destination": "stderr",
            "logging_collector": "off",
            "log_min_messages": "warning",
            "client_min_messages": "warning",
            "compute_query_id": "on",
        }
        dynpath = self.dynamic_library_path()
        if dynpath:
            gucs["dynamic_library_path"] = dynpath
        for item in self.args.extra_server_option:
            key, sep, value = item.partition("=")
            if not sep:
                raise BenchError(f"server option must be key=value: {item}")
            gucs[key] = value
        return gucs

    def start(self, scenario, gucs):
        if self.proc is not None:
            raise BenchError("server already running")
        scenario.mkdir(parents=True, exist_ok=True)
        stderr_path = scenario / "server.stderr"
        self.stderr_file = open(stderr_path, "ab", buffering=0)
        merged = self.common_gucs()
        merged.update(gucs)
        cmd = [
            self.paths["postgres"],
            "-D", str(self.pgdata),
            "-p", str(self.port),
        ]
        for key, value in merged.items():
            cmd.extend(["-c", f"{key}={value}"])
        self.proc = subprocess.Popen(
            cmd,
            stdout=self.stderr_file,
            stderr=self.stderr_file,
            env=self.env(),
            text=False,
        )
        deadline = time.time() + self.args.start_timeout
        last_error = ""
        while time.time() < deadline:
            if self.proc.poll() is not None:
                raise BenchError(
                    f"postgres exited during startup; see {stderr_path}"
                )
            proc = run([
                self.paths["psql"],
                "-XAtq",
                "-d", self.args.database,
                "-c", "select 1",
            ], env=self.env(), check=False)
            if proc.returncode == 0 and proc.stdout.strip() == "1":
                return stderr_path
            last_error = (proc.stderr or proc.stdout or "").strip()
            time.sleep(0.1)
        raise BenchError(f"server did not become ready: {last_error}")

    def stop(self):
        if self.proc is None:
            return
        if self.proc.poll() is None:
            self.proc.send_signal(signal.SIGTERM)
            try:
                self.proc.wait(timeout=20)
            except subprocess.TimeoutExpired:
                self.proc.kill()
                self.proc.wait(timeout=20)
        if self.stderr_file:
            self.stderr_file.close()
        self.stderr_file = None
        self.proc = None

    def reset_pgdata(self, base_pgdata):
        if self.proc is not None:
            raise BenchError("cannot reset PGDATA while server is running")
        if self.pgdata.exists():
            shutil.rmtree(self.pgdata)
        shutil.copytree(base_pgdata, self.pgdata, symlinks=True)

    def pgbench_command(self, seconds, workload):
        if workload not in WORKLOAD_OPTIONS:
            raise BenchError(f"unknown workload: {workload}")

        naccounts = self.args.scale * 100000
        aez_customers = max(2000, self.args.scale * 1000)
        aez_orders = max(20000, self.args.scale * 10000)
        aez_events = max(40000, self.args.scale * 20000)
        aez_parallel = max(100000, self.args.scale * 50000)
        cmd = [
            self.paths["pgbench"],
            "-n",
            "-M", self.args.protocol,
            "-c", str(self.args.clients),
            "-j", str(self.args.jobs),
            "-T", str(seconds),
            "-D", f"naccounts={naccounts}",
            "-D", f"aez_customers={aez_customers}",
            "-D", f"aez_orders={aez_orders}",
            "-D", f"aez_events={aez_events}",
            "-D", f"aez_parallel={aez_parallel}",
        ]
        if workload in BUILTIN_WORKLOAD_OPTIONS:
            cmd.extend(BUILTIN_WORKLOAD_OPTIONS[workload])
        else:
            scripts = self.paths["workload_scripts"][workload]
            if isinstance(scripts, list):
                for script in scripts:
                    cmd.extend(["-f", str(script)])
            else:
                cmd.extend(["-f", str(scripts)])
        cmd.append(self.args.database)
        return cmd

    def pgbench(self, seconds, appname, workload):
        return run(self.pgbench_command(seconds, workload),
                   env=self.env(appname), capture=True).stdout

    def pgbench_measured(self, seconds, appname, workload,
                         cpu_root_pid, cpu_start):
        proc = subprocess.Popen(
            self.pgbench_command(seconds, workload),
            env=self.env(appname),
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
        )
        max_cpu = cpu_start
        while proc.poll() is None:
            max_cpu = max(max_cpu, process_cpu_snapshot(cpu_root_pid))
            time.sleep(self.args.cpu_sample_interval)
        stdout, stderr = proc.communicate()
        max_cpu = max(max_cpu, process_cpu_snapshot(cpu_root_pid))
        if proc.returncode != 0:
            raise BenchError(
                "command failed: {}\n{}\n{}".format(
                    " ".join(map(str, self.pgbench_command(seconds, workload))),
                    stdout.strip(),
                    stderr.strip()).strip()
            )
        return stdout, max_cpu

    def prewarm_database(self, workload):
        sql = r"""
SELECT set_config('auto_explain.log_min_duration', '-1', true);
SELECT set_config('auto_explain_z.log_min_duration', '-1', true);
