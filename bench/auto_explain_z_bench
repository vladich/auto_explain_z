def apply_standard_matrix(args):
    if not args.standard_matrix:
        return

    args.workloads = STANDARD_MATRIX["workloads"]
    args.auto_explain_formats = STANDARD_MATRIX["auto_explain_formats"]
    args.aez_profiles = STANDARD_MATRIX["aez_profiles"]
    args.compressions = STANDARD_MATRIX["compressions"]
    args.template_modes = STANDARD_MATRIX["template_modes"]


def main(argv):
    args = parse_args(argv)
    apply_standard_matrix(args)
    aez_root = extension_root(sys.argv[0])
    pg_root = postgres_source_root(sys.argv[0], args.postgres_source)
    if args.build_contrib:
        build_contrib(pg_root, aez_root, args.pg_config)

    bindir = get_bindir(args.pg_config)
    sharedir = get_sharedir(args.pg_config)
    source_bins = {}
    if pg_root is not None:
        source_bins = {
            "postgres": [pg_root / "src" / "backend" / "postgres"],
            "initdb": [pg_root / "src" / "bin" / "initdb" / "initdb"],
            "psql": [pg_root / "src" / "bin" / "psql" / "psql"],
            "pgbench": [pg_root / "src" / "bin" / "pgbench" / "pgbench"],
        }
    paths = {
        "postgres": find_bin("postgres", bindir, source_bins.get("postgres", [])),
        "initdb": find_bin("initdb", bindir, source_bins.get("initdb", [])),
        "psql": find_bin("psql", bindir, source_bins.get("psql", [])),
        "pgbench": find_bin("pgbench", bindir, source_bins.get("pgbench", [])),
    }

    cleanup = False
    if args.workdir:
        work = Path(args.workdir).resolve()
        work.mkdir(parents=True, exist_ok=True)
    else:
        work = Path(tempfile.mkdtemp(prefix="auto_explain_z_bench.")).resolve()
        cleanup = not args.keep
    paths["work"] = work
    paths["sock"] = Path(tempfile.mkdtemp(prefix="aezsock.", dir="/tmp")).resolve()
    if pg_root is not None and str(paths["initdb"]).startswith(str(pg_root)):
        paths.update(source_tree_bindir(paths, work, pg_root))
        paths["share"] = source_tree_sharedir(pg_root, work, sharedir)
    paths["workload_scripts"] = write_custom_workload_scripts(work)

    cluster = Cluster(args, paths, pg_root, aez_root)
    results = []
    success = False
    try:
        cluster.initdb()
        cluster.prepare_pgbench()
        base_pgdata = None
        if args.reset_between_scenarios:
            base_pgdata = paths["work"] / "base_data"
            if base_pgdata.exists():
                shutil.rmtree(base_pgdata)
            shutil.move(str(cluster.pgdata), str(base_pgdata))

        scenarios = []
        if not args.skip_baseline:
            scenarios.append("baseline")
        if not args.skip_auto_explain:
            if args.auto_explain_formats is None:
                scenarios.append("auto_explain")
            else:
                for fmt in split_csv(args.auto_explain_formats):
                    if fmt not in ("text", "json", "yaml", "xml"):
                        raise BenchError(f"unknown auto_explain format: {fmt}")
                    scenarios.append(f"auto_explain_{fmt}")
        matrix_mode = args.compressions is not None or args.template_modes is not None
        compressions = (split_csv(args.compressions)
                        if args.compressions is not None else [args.compression])
        for compression in compressions:
            if compression not in ("default", "none", "lz4", "zstd"):
                raise BenchError(f"unknown compression: {compression}")
        template_modes = (split_csv(args.template_modes)
                          if args.template_modes is not None
                          else ["on" if args.template_cache else "off"])
        template_modes = ["tpl" if parse_template_mode(mode) else "notpl"
                          for mode in template_modes]

        for profile in split_csv(args.aez_profiles):
            if profile not in ("simple", "full"):
                raise BenchError(f"unknown auto_explain_z profile: {profile}")
            if matrix_mode:
                for compression in compressions:
                    for template_mode in template_modes:
                        scenarios.append(
                            f"auto_explain_z_{profile}_{compression}_{template_mode}")
            else:
                scenarios.append(f"auto_explain_z_{profile}")

        workloads = split_csv(args.workloads)
        for workload in workloads:
            if workload not in WORKLOAD_OPTIONS:
                raise BenchError(f"unknown workload: {workload}")

        for workload in workloads:
            if args.burnin_baseline:
                if args.reset_between_scenarios:
                    cluster.reset_pgdata(base_pgdata)
                print(f"running {workload} baseline burn-in...",
                      flush=True)
                run_scenario(cluster, args, "baseline", workload, 0)
            for iteration in range(1, args.iterations + 1):
                for scenario in scenarios:
                    if args.reset_between_scenarios:
                        cluster.reset_pgdata(base_pgdata)
                    print(f"running {workload} {scenario} iteration {iteration}...",
                          flush=True)
                    results.append(run_scenario(cluster, args, scenario,
                                                workload, iteration))

        print_table(results)
        if args.json_output:
            Path(args.json_output).write_text(
                json.dumps({
                    "runs": results,
                    "summary": summarize_results(results),
                }, indent=2),
                encoding="utf-8")
        if cleanup:
            print(f"workdir removed: {work}")
        else:
            print(f"workdir: {work}")
        success = True
    finally:
        cluster.stop()
        shutil.rmtree(paths["sock"], ignore_errors=True)
        if cleanup:
            if work.exists():
                shutil.rmtree(work, ignore_errors=True)
                if not success:
                    print(f"workdir removed after failure: {work}",
                          file=sys.stderr)


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except BenchError as e:
        print(f"auto_explain_z_bench: {e}", file=sys.stderr)
        sys.exit(1)
