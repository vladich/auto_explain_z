def parse_template_mode(value):
    normalized = value.strip().lower()
    if normalized in ("on", "true", "1", "yes", "template", "templated", "tpl"):
        return True
    if normalized in ("off", "false", "0", "no", "notpl", "no-template",
                      "non-templated", "untemplated"):
        return False
    raise BenchError(f"unknown template mode: {value}")


def aez_scenario_config(args, scenario):
    if not scenario.startswith("auto_explain_z_"):
        return None

    tail = scenario.removeprefix("auto_explain_z_")
    parts = tail.split("_")
    if len(parts) == 1:
        return {
            "profile": parts[0],
            "compression": args.compression,
            "template_cache": args.template_cache,
        }
    if len(parts) == 3:
        return {
            "profile": parts[0],
            "compression": parts[1],
            "template_cache": parse_template_mode(parts[2]),
        }
    raise BenchError(f"invalid auto_explain_z scenario name: {scenario}")


def scenario_metadata(args, scenario):
    if scenario == "baseline":
        return {"kind": "baseline"}
    if scenario == "auto_explain":
        return {
            "kind": "auto_explain",
            "format": args.auto_explain_format,
        }
    if scenario.startswith("auto_explain_") and not scenario.startswith("auto_explain_z_"):
        return {
            "kind": "auto_explain",
            "format": scenario.removeprefix("auto_explain_"),
        }
    config = aez_scenario_config(args, scenario)
    if config is None:
        raise BenchError(f"unknown scenario: {scenario}")
    return {
        "kind": "auto_explain_z",
        **config,
    }


def scenario_gucs(args, scenario, aez_dir):
    analyze = "on" if args.analyze else "off"
    timing = "on" if args.timing else "off"
    buffers = "on" if args.buffers and args.analyze else "off"
    wal = "on" if args.wal and args.analyze else "off"

    if scenario == "baseline":
        return {}

    if scenario == "auto_explain" or (
        scenario.startswith("auto_explain_") and
        not scenario.startswith("auto_explain_z_")
    ):
        log_format = (args.auto_explain_format if scenario == "auto_explain"
                      else scenario.removeprefix("auto_explain_"))
        return {
            "session_preload_libraries": "auto_explain",
            "auto_explain.log_min_duration": "0",
            "auto_explain.sample_rate": str(args.sample_rate),
            "auto_explain.log_analyze": analyze,
            "auto_explain.log_timing": timing,
            "auto_explain.log_buffers": buffers,
            "auto_explain.log_wal": wal,
            "auto_explain.log_nested_statements": "off",
            "auto_explain.log_verbose": "on" if args.verbose_plans else "off",
            "auto_explain.log_format": log_format,
        }

    config = aez_scenario_config(args, scenario)
    if config is None:
        raise BenchError(f"unknown scenario: {scenario}")
    profile = config["profile"]
    gucs = {
        "shared_preload_libraries": "auto_explain_z",
        "auto_explain_z.log_min_duration": "0",
        "auto_explain_z.sample_rate": str(args.sample_rate),
        "auto_explain_z.log_analyze": analyze,
        "auto_explain_z.log_timing": timing,
        "auto_explain_z.log_buffers": buffers,
        "auto_explain_z.log_wal": wal,
        "auto_explain_z.log_nested_statements": "off",
        "auto_explain_z.log_verbose": "on" if args.verbose_plans else "off",
        "auto_explain_z.log_query_text": "on" if args.query_text else "off",
        "auto_explain_z.profile": profile,
        "auto_explain_z.directory": str(aez_dir),
        "auto_explain_z.template_cache": "on" if config["template_cache"] else "off",
        "auto_explain_z.max_templates": str(args.max_templates),
        "auto_explain_z.template_min_plan_bytes": str(args.template_min_plan_bytes),
    }
    if config["compression"] != "default":
        gucs["auto_explain_z.compression"] = config["compression"]
    return gucs


def run_scenario(cluster, args, name, workload, iteration):
    scenario_dir = cluster.paths["work"] / workload / name / str(iteration)
    aez_dir = scenario_dir / "aez"
    aez_dir.mkdir(parents=True, exist_ok=True)
    gucs = scenario_gucs(args, name, aez_dir)
    stderr_path = cluster.start(scenario_dir, gucs)
    stopped = False
    try:
        if args.prewarm:
            cluster.prewarm_database(workload)

        if args.warmup > 0:
            cluster.pgbench(args.warmup, f"{name}_{workload}_warmup",
                            workload)

        log_start = file_size(stderr_path)
        aez_start = dir_size(aez_dir)
        server_cpu_start = process_cpu_snapshot(cluster.proc.pid)
        child_cpu_start = child_cpu_snapshot()
        wall_start = time.monotonic()

        output, server_cpu_end = cluster.pgbench_measured(args.duration, name,
                                                          workload,
                                                          cluster.proc.pid,
                                                          server_cpu_start)

        wall = time.monotonic() - wall_start
        child_cpu = child_cpu_snapshot() - child_cpu_start
        server_cpu = server_cpu_end - server_cpu_start
        log_bytes = file_size(stderr_path) - log_start
        aez_runtime_bytes = dir_size(aez_dir) - aez_start
        cluster.stop()
        stopped = True
        aez_bytes = dir_size(aez_dir) - aez_start
        parsed = parse_pgbench(output)

        tx = parsed.get("transactions", 0)
        total_log_bytes = log_bytes + aez_bytes
        result = {
            "scenario": name,
            "workload": workload,
            "iteration": iteration,
            "prewarm": args.prewarm,
            "scenario_config": scenario_metadata(args, name),
            "pgbench": parsed,
            "wall_seconds": wall,
            "server_cpu_seconds": server_cpu,
            "pgbench_cpu_seconds": child_cpu,
            "regular_log_bytes": log_bytes,
            "auto_explain_z_bytes": aez_bytes,
            "auto_explain_z_runtime_bytes": aez_runtime_bytes,
            "total_plan_log_bytes": total_log_bytes,
            "bytes_per_transaction": (total_log_bytes / tx) if tx else None,
            "stderr_path": str(stderr_path),
            "auto_explain_z_dir": str(aez_dir),
        }
        return result
    finally:
        if not stopped:
            cluster.stop()


def summarize_results(results):
    groups = {}
    for result in results:
        key = (result["workload"], result["scenario"])
        groups.setdefault(key, []).append(result)

    baseline_tps = {}
    for (workload, scenario), items in groups.items():
        if scenario != "baseline":
            continue
        values = [
            r["pgbench"].get("tps") for r in items
            if r["pgbench"].get("tps") is not None
        ]
        if values:
            baseline_tps[workload] = statistics.mean(values)

    summary = []
    for key in sorted(groups):
        workload, scenario = key
        items = groups[key]
        tps_values = [
            r["pgbench"].get("tps") for r in items
            if r["pgbench"].get("tps") is not None
        ]
        lat_values = [r["pgbench"].get("latency_ms", 0) for r in items]
        cpu_values = [
            100.0 * r["server_cpu_seconds"] / r["wall_seconds"]
            for r in items if r["wall_seconds"] > 0
        ]
        bytes_values = [r["total_plan_log_bytes"] for r in items]
        bytes_tx_values = [
            r["bytes_per_transaction"] for r in items
            if r["bytes_per_transaction"] is not None
        ]
        tps_mean = statistics.mean(tps_values) if tps_values else None
        base = baseline_tps.get(workload)
        summary.append({
            "workload": workload,
            "scenario": scenario,
            "runs": len(items),
            "tps_mean": tps_mean,
            "tps_stdev": statistics.stdev(tps_values)
            if len(tps_values) > 1 else 0.0,
            "latency_ms_mean": statistics.mean(lat_values) if lat_values else None,
            "server_cpu_pct_mean": statistics.mean(cpu_values) if cpu_values else None,
            "log_bytes_mean": statistics.mean(bytes_values) if bytes_values else None,
            "bytes_per_transaction_mean": statistics.mean(bytes_tx_values)
            if bytes_tx_values else None,
            "tps_overhead_pct": 100.0 * (base - tps_mean) / base
            if base and tps_mean else None,
        })
    return summary


def print_table(results):
    summary = summarize_results(results)
    headers = [
        "workload", "scenario", "runs", "tps_mean", "tps_sd",
        "lat_ms", "cpu_pct", "log_bytes", "bytes_tx", "tps_overhead",
    ]
    rows = []
    for result in summary:
        rows.append([
            result["workload"],
            result["scenario"],
            str(result["runs"]),
            f"{result['tps_mean']:.1f}" if result["tps_mean"] is not None else "",
            f"{result['tps_stdev']:.1f}",
            f"{result['latency_ms_mean']:.3f}" if result["latency_ms_mean"] is not None else "",
            f"{result['server_cpu_pct_mean']:.1f}" if result["server_cpu_pct_mean"] is not None else "",
            f"{result['log_bytes_mean']:.0f}" if result["log_bytes_mean"] is not None else "",
            f"{result['bytes_per_transaction_mean']:.1f}" if result["bytes_per_transaction_mean"] is not None else "",
            f"{result['tps_overhead_pct']:.2f}%" if result["tps_overhead_pct"] is not None else "",
        ])
    widths = [
        max(len(headers[i]), *(len(row[i]) for row in rows))
        for i in range(len(headers))
    ]
    print("  ".join(headers[i].ljust(widths[i]) for i in range(len(headers))))
    print("  ".join("-" * widths[i] for i in range(len(headers))))
    for row in rows:
        print("  ".join(row[i].ljust(widths[i]) for i in range(len(headers))))


